/* ---------------------------------------------------------------------------
 * "Modern" theme for GitFourchette.
 *
 * This is a template: placeholder tokens are substituted by themes.py.
 * This stylesheet is appended to the base stylesheet.
 * ------------------------------------------------------------------------ */

/* --------------------------------------------------------------------------
 * Window chrome
 * ------------------------------------------------------------------------ */

QMainWindow, QDialog {
    background: ${bg};
}

QMainWindow::separator {
    background: ${border};
    width: 1px;
    height: 1px;
}

QToolTip {
    background: ${tooltipBg};
    color: ${tooltipText};
    border: 1px solid ${tooltipBorder};
    border-radius: ${menuRadius};
    padding: 2px 4px;
}

QStatusBar {
    background: ${bg};
    color: ${textDim};
    border-top: 1px solid ${border};
}

QStatusBar::item {
    border: none;
}

QStatusBar MemoryIndicator {  /* in debug mode only */
    padding: 0;
}

/* --------------------------------------------------------------------------
 * Menu bar & menus
 * ------------------------------------------------------------------------ */

QMenuBar {
    background: ${bg};
    color: ${text};
    border: none;
    padding: 2px 3px;
}

QMenuBar::item {
    background: transparent;
    color: ${text};
    padding: 4px 9px;
    margin: 0px 1px;
    border-radius: ${outerRadius};
}

QMenuBar::item:selected {
    background: ${hover};
}

QMenuBar::item:pressed {
    background: ${accent};
    color: ${onAccent};
}

QMenu, QComboBox QAbstractItemView {
    border-radius: ${menuRadius};
    background: ${button};
    color: ${text};
    border: 1px solid ${border};
    padding: 5px 4px;
}

QComboBox QAbstractItemView {
    border-radius: ${comboBoxMenuRadius};
}

QMenu::item {
    background: transparent;
    padding: 5px 24px 5px 8px;
    border-radius: ${innerRadius};
    margin: 0px 2px;
}

QMenu::item:selected {
    background: ${accent};
    color: ${onAccent};
}

QMenu::item:disabled {
    background: transparent;
    color: ${textFaint};
}

QMenu::separator {
    height: 1px;
    background: ${border};
    margin: 5px 8px;
}

QMenu::icon {
    margin-left: 7px;
}

QMenu::indicator {
    margin-left: 8px;
    width: 13px;
    height: 13px;
}

/* --------------------------------------------------------------------------
 * Main toolbar
 * ------------------------------------------------------------------------ */

QToolBar {
    background: ${bg};
    border: none;
    padding: 4px 6px;
    spacing: 2px;
    border-bottom: 1px solid ${border};
}

QMainWindow QToolBar {
    border-bottom: none;
}

QToolBar::separator {
    background: ${border};
    width: 1px;
    height: 1px;
    margin: 5px 7px;
}

/* --------------------------------------------------------------------------
 * Buttons
 * ------------------------------------------------------------------------ */

QPushButton,
QToolButton {
    background: ${button};
    color: ${text};
    border: 1px solid ${border};
    border-radius: ${outerRadius};
}

QToolButton {
    padding: 3px 7px;
}

QPushButton {
    padding: 5px 14px;
    min-width: 56px;
}

QPushButton:flat,
QToolButton[autoRaise="true"] {
    border-color: transparent;
    background: transparent;
}

QPushButton:hover,
QToolButton:hover,
QToolButton:focus {
    background: ${buttonHover};
}

QToolButton[autoRaise="true"]:hover {
    background: ${hover};
}

QPushButton:pressed {
    padding-bottom: 3px;
}

QToolButton:pressed {
    padding-bottom: 1px;
}

QToolButton:disabled {
    background: transparent;
    color: ${textFaint};
}

QToolButton::menu-button {
    background: transparent;
    border: none;
    border-top-right-radius: 7px;
    border-bottom-right-radius: 7px;
    width: 14px;
}

QToolButton::menu-arrow {
    width: 8px;
    height: 8px;
}

QPushButton:default, QPushButton:focus {
    border-color: ${accent};
}

QPushButton:default {
    background: ${defaultButton};
}

QPushButton:default:hover {
    background: ${defaultButtonHover};
}

QPushButton:default:pressed,
QPushButton:pressed,
QToolButton:pressed {
    background: ${buttonPressed};
}

QToolButton:checked,
QToolButton:on {
    background: ${hover};
}

QPushButton:disabled {
    background: ${inputDisabled};
    color: ${textFaint};
    border-color: ${border};
}

QPushButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
}

/* --------------------------------------------------------------------------
 * Text entry & combo boxes
 * ------------------------------------------------------------------------ */

QLineEdit,
QSpinBox,
QDateTimeEdit,
QComboBox,
QTextEdit,
QPlainTextEdit {
    background: ${surface};
    color: ${text};
    border: 1px solid ${border};
    border-radius: ${outerRadius};
    padding: 4px 6px;
    selection-background-color: ${accent};
    selection-color: ${onAccent};
}

QComboBox {
    padding-right: 1em;
}

QSpinBox::down-button, QSpinBox::up-button {
    subcontrol-origin: padding;
    width: 20px;
    height: 100%;
    border: 0px solid ${border};
}

QSpinBox::down-button {
    subcontrol-position: left;
    border-right-width: 1px;
}

QSpinBox::up-button {
    subcontrol-position: right;
    border-left-width: 1px;
}

QSpinBox::down-arrow {
    image: url(assets:icons/qss-minus.svg);
}

QSpinBox::up-arrow {
    image: url(assets:icons/qss-plus.svg);
}

QLineEdit:focus,
QSpinBox:focus,
QDateTimeEdit:focus,
QComboBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:on,
QComboBox::drop-down:focus,
QComboBox::drop-down:on,
QSpinBox::down-button:focus,
QSpinBox::up-button:focus {
    border-color: ${accent};
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QComboBox:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background: ${inputDisabled};
    color: ${textFaint};
    border-color: ${border};
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    width: 16px;
    border-left: 1px solid ${border};
}

QComboBox::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(assets:icons/qss-down.svg);
}

/* --------------------------------------------------------------------------
 * Tab bars
 * ------------------------------------------------------------------------ */

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
    border-bottom: 1px solid ${border};
}

QTabBar::tab {
    color: ${textDim};
    margin-left: 1px;
    margin-right: 1px;

    padding: 6px 12px;
    border-radius: ${outerRadius};
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;

    border: 1px solid transparent;
    border-bottom: 0;
    border-color: transparent;
}

QTabBar::tab:first {
    border-top-left-radius: 0px;
    border-left: none;
}

QTabBar::tab:last {
    border-top-right-radius: 0px;
    border-right: none;
}

QTabBar::tab:hover {
    background: ${hover};
    color: ${text};
}

QTabBar::tab:selected {
    border-color: ${border};
    background-color: ${surface};
    font-weight: bold;
}

/* --------------------------------------------------------------------------
 * Splitters
 * ------------------------------------------------------------------------ */

QSplitter::handle {
    background: ${textFaint};
}

QSplitter::handle:hover, QSplitter::handle:pressed {
    background: ${accent};
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QFaintSeparator {
    background: ${border};
    border: none;
}

/* --------------------------------------------------------------------------
 * Item views
 * ------------------------------------------------------------------------ */

QAbstractItemView {
    background: ${surface};
    color: ${text};
    alternate-background-color: ${altRow};
    border: 1px solid ${border};
    border-radius: ${outerRadius};
}

QAbstractItemView:focus, QAbstractItemView:focus {
    border-color: ${accent};
}

QComboBox QAbstractItemView:focus {  /* kill accent border on QComboBox menu */
    border-color: ${border};
}

RepoWidget Sidebar, RepoWidget FileList, RepoWidget GraphView {
    border: none;
    border-radius: 0;
    outline: 0;
}

QAbstractItemView {
    padding: 1px;
}

QAbstractItemView::item {
    color: ${text};
    border-radius: ${innerRadius};
}

QAbstractItemView::item:hover {
    background: ${hover};
}

QAbstractItemView::item:selected {
    background: ${selInactive};
    color: ${text};
}

QAbstractItemView::item:selected:active {
    background: ${accent};
    color: ${onAccent};
}

/* --------------------------------------------------------------------------
 * Scroll bars
 * ------------------------------------------------------------------------ */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle {
    background: ${scrollHandle};
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    min-height: 32px;
    margin: 1px 3px;
}

QScrollBar::handle:horizontal {
    min-width: 32px;
    margin: 3px 1px;
}

QScrollBar::handle:hover, QScrollBar::handle:pressed {
    background: ${accent};
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}

QScrollBar::up-arrow, QScrollBar::down-arrow,
QScrollBar::left-arrow, QScrollBar::right-arrow {
    background: transparent;
    image: none;
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* --------------------------------------------------------------------------
 * Misc controls
 * ------------------------------------------------------------------------ */

QGroupBox {
    border: 1px solid ${border};
    border-radius: ${outerRadius};
    padding: 4px;
}

QProgressBar {
    background: ${surface};
    border: 1px solid ${border};
    border-radius: ${outerRadius};
    text-align: center;
    color: ${text};
}

QProgressBar::chunk {
    background: ${accent};
    border-radius: ${innerRadius};
    margin: 1px;
}

/* --------------------------------------------------------------------------
 * GitFourchette-specific widgets
 * ------------------------------------------------------------------------ */

GraphView::item, FileList::item {
    border-radius: 0;
}

Sidebar::item { height: 1.25em; }
FileList::item, StashDialog #fileList::item { height: 1.15em; }

Sidebar {
    background: palette(window);
    color: ${text};
    show-decoration-selected: 1;
}

Sidebar::item {
    border-radius: ${innerRadius};
    border-bottom-left-radius: 0px;
    border-top-left-radius: 0px;
}

Sidebar::item:hover:!selected {
    border-radius: 0px;  /* avoid "dented" effect */
}

/* Code panes must stay flush - no rounded frame, no inner padding. */
CodeView, SpecialDiffView {
    background: ${surface};
    border: none;
    border-radius: 0;
    padding: 0;
}

/* Don't shrink icons in small QToolButtons */
QHintButton, ContextHeader QToolButton {
    padding-top: 0px;
    padding-bottom: 0px;
}

DiffArea QLabel.panelTitle {
    color: ${textDim};
}

SearchBar QLineEdit {
    border: 1px solid ${border};
    border-radius: ${outerRadius};
    padding: 3px 0px;
}

SearchBar[red] QLineEdit {
    color: ${danger};
    border-color: ${danger};
}

/* Fusion quirk: QComboBox's list view always inherits QComboBox's top-padding.
https://web.archive.org/web/qtcentre.org/threads/69272-QComboBox-padding-bug */
${fusionOnly}QComboBox { combobox-popup: 0; }
${fusionOnly}QComboBox QAbstractItemView::item { padding: 4px 2px; }
