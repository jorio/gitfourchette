#: trtables.py:372
msgid "Allow third-party Pygments plugins"
msgstr "Povolit zásuvné moduly Pygments třetích stran"

#: trtables.py:373
#, python-brace-format
msgid "Let {app} load third-party Pygments plugins installed on your system. These plugins extend syntax highlighting with new languages and color schemes. <b>May incur significant slowdowns.</b>"
msgstr "Povolit aplikaci {app} načítat zásuvné moduly Pygments třetích stran nainstalované ve vašem systému. Tyto moduly rozšiřují zvýrazňování syntaxe o nové jazyky a barevná schémata. <b>Mohou výrazně zpomalit aplikaci.</b>"

#: trtables.py:376
msgid "Sort branches && tags by"
msgstr "Řadit větve && značky podle"

#: trtables.py:378
msgid "The default sorting mode for local branches, remote branches, and tags in the sidebar."
msgstr "Výchozí způsob řazení místních větví, vzdálených větví a značek v postranním panelu."

#: trtables.py:379
msgid "You can fine-tune this setting in each repo by right-clicking Branches, Remotes, or Tags in the sidebar. (Note that changing the default setting here will clear per-repo tweaks.)"
msgstr "Toto nastavení můžete pro každý repozitář upravit kliknutím pravým tlačítkem na Větve, Vzdálené repozitáře nebo Značky v postranním panelu. (Změna zdejšího výchozího nastavení zruší úpravy jednotlivých repozitářů.)"

#: trtables.py:382
msgid "Font"
msgstr "Písmo"

#: trtables.py:383
msgid "One tab is # spaces"
msgstr "Jeden tabulátor odpovídá # mezerám"

#: trtables.py:385
msgid "Amount of unmodified lines to show around red or green lines in a diff."
msgstr "Počet nezměněných řádků zobrazených kolem červených nebo zelených řádků v porovnání."

#: trtables.py:386
msgid "Load diffs up to # KB"
msgstr "Načítat porovnání do # kB"

#: trtables.py:387
msgid "Load images up to # KB"
msgstr "Načítat obrázky do # kB"

#: trtables.py:388
msgid "Syntax highlighting"
msgstr "Zvýrazňování syntaxe"

#: trtables.py:389
msgid "Word wrap"
msgstr "Zalamování řádků"

#: trtables.py:390
msgid "Show alien line endings (CRLF)"
msgstr "Zobrazovat odlišná zakončení řádků (CRLF)"

#: trtables.py:391
msgid "Show whitespace symbols"
msgstr "Zobrazovat značky bílých znaků"

#: trtables.py:392
msgid "Whitespace diffs"
msgstr "Změny bílých znaků v porovnání"

#: trtables.py:394
msgid "How whitespace changes are shown in diffs."
msgstr "Způsob zobrazení změn bílých znaků v porovnáních."

#: trtables.py:395
msgid "This setting only affects how diffs are displayed. Operations that handle patches (export, apply, revert, etc.) still honor all whitespace changes."
msgstr "Toto nastavení ovlivňuje pouze zobrazení porovnání. Operace pracující se záplatami (export, použití, vrácení apod.) nadále zohledňují všechny změny bílých znaků."

#: trtables.py:397
msgid "“-/+” colors"
msgstr "Barvy „−/+“"

#: trtables.py:398
msgid "Background colors for deleted (-) and added (+) lines."
msgstr "Barvy pozadí odstraněných (−) a přidaných (+) řádků."

#: trtables.py:399
msgid "SVG files"
msgstr "Soubory SVG"

#: trtables.py:400
msgid "Display as text"
msgstr "Zobrazovat jako text"

#: trtables.py:401
msgid "Display as images"
msgstr "Zobrazovat jako obrázky"

#: trtables.py:403
msgid "Show tab close button"
msgstr "Zobrazovat tlačítko pro zavření karty"

#: trtables.py:404
msgid "Expand tabs to available width"
msgstr "Roztáhnout karty na dostupnou šířku"

#: trtables.py:405
msgid "Auto-hide tabs if only one repo is open"
msgstr "Automaticky skrýt karty, je-li otevřen jen jeden repozitář"

#: trtables.py:407
msgid "Sort commits"
msgstr "Řazení commitů"

#: trtables.py:408
msgid "Chronologically"
msgstr "Chronologicky"

#: trtables.py:409
msgid "Topologically"
msgstr "Topologicky"

#: trtables.py:411
msgid "<b>Chronological mode</b> lets you stay on top of the latest activity in the repository. The most recent commits always show up at the top of the graph. However, the graph can get messy when multiple branches receive commits in the same timeframe."
msgstr "<b>Chronologický režim</b> poskytuje přehled o nejnovější aktivitě v repozitáři. Nejnovější commity se vždy zobrazují v horní části grafu. Pokud však commity ve stejném období přibývají do více větví, graf může být nepřehledný."

#: trtables.py:414
msgid "<b>Topological mode</b> makes the graph easier to read. It attempts to present sequences of commits within a branch in a linear fashion. Since this is not a strictly chronological mode, you may have to do more scrolling to see the latest changes in various branches."
msgstr "<b>Topologický režim</b> usnadňuje čtení grafu. Snaží se zobrazovat posloupnosti commitů v jednotlivých větvích lineárně. Protože nejde o přísně chronologický režim, může být k zobrazení nejnovějších změn v různých větvích potřeba více posouvání."

#: trtables.py:418
msgid "Row spacing"
msgstr "Rozestupy řádků"

#: trtables.py:419
msgid "Avoid gaps between branches in the graph"
msgstr "Omezit mezery mezi větvemi v grafu"

#: trtables.py:420
msgid "Mark author/committer signature differences"
msgstr "Označovat rozdíly mezi údaji autora a autora zápisu"

#: trtables.py:422
msgid "The commit history displays information about a commit’s <b>author</b>—their name and the date at which they made the commit. But in some cases, a commit might have been revised by someone else than the original author—this person is called the <b>committer</b>."
msgstr "Historie commitů zobrazuje údaje o <b>autorovi</b> commitu – jeho jméno a datum vytvoření commitu. Commit však někdy mohl upravit někdo jiný než původní autor; této osobě se říká <b>autor zápisu</b>."

#: trtables.py:426
msgid "If you tick this option, an asterisk (*) will appear after the author’s name and/or date if they differ from the committer’s for any given commit."
msgstr "Pokud tuto možnost zaškrtnete, zobrazí se za jménem autora nebo datem hvězdička (*), jestliže se u daného commitu liší od údajů autora zápisu."

#: trtables.py:428
msgid "Note that you can always hover over the author’s name or date to obtain detailed information about the author and the committer."
msgstr "Podrobné údaje o autorovi a autorovi zápisu můžete kdykoli zobrazit najetím na jméno nebo datum autora."

#: trtables.py:431
msgid "Load up to # commits in the history"
msgstr "Načítat v historii až # commitů"

#: trtables.py:432
msgid "Set to 0 to always load the full commit history."
msgstr "Nastavením hodnoty 0 se vždy načte celá historie commitů."

#: trtables.py:433
msgid "Draw rows using alternating background colors"
msgstr "Střídat barvy pozadí řádků"

#: trtables.py:434
msgid "Ref indicators"
msgstr "Indikátory referencí"

#: trtables.py:435
msgid "You can always hover over an indicator to display the full name of the ref."
msgstr "Úplný název reference můžete kdykoli zobrazit najetím na indikátor."

#: trtables.py:436
msgid "Verify signed commits on the fly"
msgstr "Průběžně ověřovat podepsané commity"

#: trtables.py:438
#, python-brace-format
msgid "As commits scroll into view, call {0} automatically to verify their signatures. The verification status is materialized by a seal icon next to the author’s name:"
msgstr "Jakmile se commity posunou do zobrazené oblasti, automaticky zavolat {0} a ověřit jejich podpisy. Stav ověření znázorňuje ikona pečeti vedle jména autora:"

#: trtables.py:440
msgid "(No seal = Commit isn’t signed)"
msgstr "(Bez pečeti = commit není podepsaný)"

#: trtables.py:442
msgid "The trash keeps up to # discarded patches"
msgstr "Koš uchovává až # zahozených záplat"

#: trtables.py:443
msgid "Patches bigger than # KB won’t be salvaged"
msgstr "Záplaty větší než # kB nebudou zachráněny"

#: trtables.py:445
#, python-brace-format
msgid "When you discard changes from the working directory, {app} keeps a temporary copy in a hidden “trash” folder. This gives you a last resort to rescue changes that you have discarded by mistake. You can look around this trash folder via <i>“Help &rarr; Open Trash”</i>."
msgstr "Když zahodíte změny z pracovního adresáře, aplikace {app} uloží jejich dočasnou kopii do skryté složky „koše“. Díky tomu můžete v krajním případě zachránit změny, které jste zahodili omylem. Obsah koše můžete procházet pomocí nabídky <i>„Nápověda &rarr; Otevřít koš“</i>."

#: trtables.py:449
msgid "Logging verbosity"
msgstr "Podrobnost protokolování"

#: trtables.py:450
msgid "Auto-refresh when app regains focus"
msgstr "Automaticky aktualizovat po návratu do aplikace"

#: trtables.py:452
#, python-brace-format
msgid "When you return to {app} from another application, it automatically scans for changes in the working directory and local branches. This keeps the interface in sync with the state of your repo on disk."
msgstr "Když se do aplikace {app} vrátíte z jiné aplikace, automaticky vyhledá změny v pracovním adresáři a místních větvích. Rozhraní tak zůstane synchronizované se stavem repozitáře na disku."

#: trtables.py:455
#, python-brace-format
msgid "If you turn this off, you will need to hit {key} to perform this refresh manually."
msgstr "Pokud tuto možnost vypnete, budete muset aktualizaci spouštět ručně klávesou {key}."

#: trtables.py:457
msgid "We strongly recommend to keep this setting enabled."
msgstr "Důrazně doporučujeme ponechat toto nastavení zapnuté."

#: trtables.py:458
msgid "Auto-fetch remotes every # minutes"
msgstr "Automaticky načítat vzdálené repozitáře každých # minut"

#: trtables.py:459
msgid "Animation effects in sidebar"
msgstr "Animace v postranním panelu"

#: trtables.py:460
msgid "Smooth scrolling (where applicable)"
msgstr "Plynulé posouvání (kde je podporováno)"

#: trtables.py:461
msgid "Preferred Qt binding"
msgstr "Upřednostňovaná vazba Qt"

#: trtables.py:463
#, python-brace-format
msgid "After restarting, {app} will use this Qt binding if available."
msgstr "Po restartování použije aplikace {app} tuto vazbu Qt, bude-li dostupná."

#: trtables.py:464
msgid "You can also pass the name of a Qt binding via the “QT_API” environment variable."
msgstr "Název vazby Qt lze také předat prostřednictvím proměnné prostředí „QT_API“."

#: trtables.py:466
msgid "Use condensed fonts"
msgstr "Používat zúžená písma"

#: trtables.py:468
msgid "When a branch name or author name is too long to fit in its allotted space, condense the font before truncating the text."
msgstr "Pokud se název větve nebo jméno autora nevejde do vyhrazeného prostoru, před zkrácením textu nejprve zúžit písmo."

#: trtables.py:471
msgid "Text editor"
msgstr "Textový editor"

#: trtables.py:474 trtables.py:480 trtables.py:488
msgid "Argument placeholders:"
msgstr "Zástupné symboly argumentů:"

#: trtables.py:475
msgid "Old / Left"
msgstr "Starý / vlevo"

#: trtables.py:476
msgid "New / Right"
msgstr "Nový / vpravo"

#: trtables.py:481
msgid "Ancestor / Base / Center"
msgstr "Předek / základ / uprostřed"

#: trtables.py:482
msgid "Ours / Local / Left"
msgstr "Naše / místní / vlevo"

#: trtables.py:483
msgid "Theirs / Remote / Right"
msgstr "Jejich / vzdálené / vpravo"

#: trtables.py:484
msgid "Merged / Output / Result"
msgstr "Sloučené / výstup / výsledek"

#: trtables.py:489
msgid "Command to execute after launching the terminal"
msgstr "Příkaz spuštěný po otevření terminálu"

#: trtables.py:490
#, python-brace-format
msgid "The {0} placeholder is mandatory. It is automatically substituted for a wrapper script that enters your working directory and optionally starts one of your Custom Commands."
msgstr "Zástupný symbol {0} je povinný. Automaticky jej nahradí pomocný skript, který přejde do vašeho pracovního adresáře a volitelně spustí některý z vlastních příkazů."

#: trtables.py:494
#, python-brace-format
msgid "Have OpenSSH ask for passphrases via {app}"
msgstr "Nechat OpenSSH žádat o přístupové fráze prostřednictvím aplikace {app}"

#: trtables.py:496
#, python-brace-format
msgid "Tick this to have OpenSSH use {app} to ask for passphrases."
msgstr "Zaškrtněte, pokud má OpenSSH žádat o přístupové fráze prostřednictvím aplikace {app}."

#: trtables.py:497
#, python-brace-format
msgid "Untick this if you’ve set up another program in the {0} environment variable (such as {1})."
msgstr "Zrušte zaškrtnutí, pokud jste v proměnné prostředí {0} nastavili jiný program (například {1})."

#: trtables.py:499
msgid "(not detected)"
msgstr "(nezjištěno)"

#: trtables.py:499
msgid "Use ssh-agent provided by the system"
msgstr "Používat ssh-agent poskytovaný systémem"

#: trtables.py:500
#, python-brace-format
msgid "Have {app} manage its own ssh-agent"
msgstr "Nechat aplikaci {app} spravovat vlastní ssh-agent"

#: trtables.py:502
msgid "“ssh-agent” can save your SSH credentials so you don’t have to retype the same passphrase over and over. Some Linux distributions set up an ssh-agent for you."
msgstr "„ssh-agent“ může uložit vaše přihlašovací údaje SSH, abyste nemuseli opakovaně zadávat stejnou přístupovou frázi. Některé linuxové distribuce nastavují ssh-agent automaticky."

#: trtables.py:504
#, python-brace-format
msgid "You can also have {app} start its own instance of ssh-agent for the duration of your session and have it remember passphrases."
msgstr "Aplikace {app} může také na dobu relace spustit vlastní instanci ssh-agent a nechat ji pamatovat si přístupové fráze."

#: trtables.py:508
msgid "Parse LFS pointers"
msgstr "Zpracovávat ukazatele LFS"

#: trtables.py:510
msgid "Tick this to display the real contents from LFS files."
msgstr "Zaškrtněte, chcete-li zobrazovat skutečný obsah souborů LFS."

#: trtables.py:511
msgid "Untick to display the raw text in LFS pointers."
msgstr "Zrušte zaškrtnutí, chcete-li zobrazovat nezpracovaný text ukazatelů LFS."

#: trtables.py:514
msgid "Mouse Shortcuts"
msgstr "Zkratky myši"

#: trtables.py:515
msgid "Tip: If your mouse has side buttons, you can use them to navigate back/forward in the repo."
msgstr "Tip: Pokud má myš boční tlačítka, můžete jimi v repozitáři přecházet zpět a vpřed."

#: trtables.py:516
msgid "Repository tabs:"
msgstr "Karty repozitářů:"

#: trtables.py:517
msgid "Double-click tab"
msgstr "Dvojité kliknutí na kartu"

#: trtables.py:518
msgid "Middle-click tab"
msgstr "Kliknutí prostředním tlačítkem na kartu"

#: trtables.py:519
msgid "File lists:"
msgstr "Seznamy souborů:"

#: trtables.py:520
msgid "Double-click file"
msgstr "Dvojité kliknutí na soubor"

#: trtables.py:521
msgid "Middle-click file"
msgstr "Kliknutí prostředním tlačítkem na soubor"

#: trtables.py:522
msgid "Diff view:"
msgstr "Zobrazení porovnání:"

#: trtables.py:523
msgid "Middle-click selection"
msgstr "Kliknutí prostředním tlačítkem na výběr"

#: trtables.py:524
msgid "Stage/unstage selected lines"
msgstr "Připravit vybrané řádky / zrušit jejich přípravu"

#: trtables.py:529
msgid "Ask for confirmation before running any command"
msgstr "Před spuštěním každého příkazu žádat o potvrzení"

#: trtables.py:531
#, python-brace-format
msgid "If you untick this, you can still force a prompt to appear for specific commands by prepending them with {0}. For example: {1}"
msgstr "Pokud zaškrtnutí zrušíte, můžete si potvrzení u konkrétních příkazů přesto vynutit přidáním {0} na začátek. Příklad: {1}"

#: trtables.py:559
msgctxt "date/time formats"
msgid "Available formats:"
msgstr "Dostupné formáty:"

#: trtables.py:561 trtables.py:562
msgid "year"
msgstr "rok"

#: trtables.py:564 trtables.py:565
msgid "month"
msgstr "měsíc"

#: trtables.py:569 trtables.py:570
msgid "day"
msgstr "den"

#: trtables.py:574 trtables.py:575
msgid "hour"
msgstr "hodina"

#: trtables.py:576
msgid "minute"
msgstr "minuta"

#: trtables.py:577
msgid "second"
msgstr "sekunda"

#: trtables.py:588
msgid "Verification pending"
msgstr "Čeká se na ověření"

#: trtables.py:589
msgid "Verification failed (e.g. missing key)"
msgstr "Ověření selhalo (např. kvůli chybějícímu klíči)"

#: trtables.py:592
msgid "Good signature; Key or signature expired"
msgstr "Platný podpis; platnost klíče nebo podpisu vypršela"

#: trtables.py:593
msgid "Key revoked or bad signature"
msgstr "Klíč byl odvolán nebo je podpis neplatný"

#: trtables.py:620
#, python-brace-format
msgid "Feel free to copy the sample below and paste it into the text box. Then, click OK, and explore {menu} in the menu bar."
msgstr "Níže uvedený příklad můžete zkopírovat a vložit do textového pole. Poté klikněte na OK a prozkoumejte nabídku {menu} na řádku nabídek."

#: trtables.py:625
msgid "&Interactive Rebase"
msgstr "&Interaktivní přeskládání"

#: trtables.py:626
msgid "&Continue Rebase"
msgstr "&Pokračovat v přeskládání"

#: trtables.py:627
msgid "&Abort Rebase"
msgstr "Pře&rušit přeskládání"

#: trtables.py:628
msgid "Diff Commit With &HEAD"
msgstr "Porovnat commit s &HEAD"

