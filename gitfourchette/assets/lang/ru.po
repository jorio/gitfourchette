msgstr "Удалить этот подмодуль из .gitmodules и удалить его рабочую копию из этого репозитория"

#: tasks/taskbook.py:149
msgid "Rename this branch locally"
msgstr "Переименовать эту ветвь локально"

#: tasks/taskbook.py:150
msgid "Make HEAD point to another commit"
msgstr "Направить HEAD на другой коммит"

#: tasks/taskbook.py:151
